# Environments & Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/dist/
/dist_app/
/build/

# Node & Frontend
node_modules/
ui/node_modules/
.npm/

# Explicitly allow pre-built frontend bundle in ui/dist/ for 1-click Git updates
!ui/dist/
!ui/dist/**

# Heavy local binaries (installed via install_tools.sh)
bin/ollama
bin/exiftool
bin/lib/
bin/

# Local databases, caches & logs (stored in ~/Library/Application Support/MRDarkroom)
data
data/
data/*.db*
*.db
*.db-shm
*.db-wal
cache/
logs/
*.log

# Personal reference photos & faces
reference_faces/*
!reference_faces/.gitkeep

# macOS & Editor
.DS_Store
.AppleDouble
.LSOverride
Icon?
Thumbs.db
.vscode/
.idea/
